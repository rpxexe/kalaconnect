<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardArtisanItem"
    style="@style/Widget.KalaConnect.Card"
    android:layout_width="@dimen/artisan_card_width"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Avatar + Details + Verified Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded Artisan Avatar -->
            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/artisan_avatar_size"
                android:layout_height="@dimen/artisan_avatar_size"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_variant">

                <ImageView
                    android:id="@+id/ivArtisanAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Artisan profile portrait"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_role_artisan" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Name with Verified Icon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvArtisanCardName"
                        style="@style/TextAppearance.KalaConnect.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textStyle="bold"
                        tools:text="Lakshmi SHG Collective" />

                    <ImageView
                        android:id="@+id/ivArtisanVerified"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Verified artisan collective"
                        android:src="@drawable/ic_verified" />
                </LinearLayout>

                <!-- Craft Specialty -->
                <TextView
                    android:id="@+id/tvArtisanCraftSpecialty"
                    style="@style/TextAppearance.KalaConnect.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    tools:text="Madhubani Folk Art" />

                <!-- Location -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="Location pin"
                        android:src="@drawable/ic_location_pin" />

                    <TextView
                        android:id="@+id/tvArtisanLocation"
                        style="@style/TextAppearance.KalaConnect.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textColor="@color/text_secondary"
                        tools:text="Madhubani, Bihar" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bio / Story Snippet -->
        <TextView
            android:id="@+id/tvArtisanStory"
            style="@style/TextAppearance.KalaConnect.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            tools:text="A women-led collective preserving 400-year-old natural dye canvas traditions." />

        <!-- Bottom Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvArtisanProductCount"
                style="@style/TextAppearance.KalaConnect.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_tertiary"
                tools:text="24 handcrafted works" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewArtisan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="View Profile"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
