<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="100dp"
    android:layout_marginEnd="10dp">

    <!-- Image Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImageContainer"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_gravity="bottom|start"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivPickedPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Product photo preview"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_card_image_placeholder" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Remove (X) Badge Button -->
    <FrameLayout
        android:id="@+id/btnRemovePhoto"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_status_badge_error"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:contentDescription="Remove photo"
            android:src="@drawable/ic_close"
            app:tint="@color/status_error" />
    </FrameLayout>

</FrameLayout>
