<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <!-- Title & Subtitle -->
            <TextView
                style="@style/TextAppearance.KalaConnect.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore Crafts"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/TextAppearance.KalaConnect.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Discover handmade traditions directly from master artisans"
                android:textColor="@color/text_secondary" />

            <!-- Search and Filter Bar Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Search Input Container -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Search Icon"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/etExploreSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search craft, artisan, SHG, skill..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnExploreClearSearch"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear search"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Filter Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreFilter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_filter"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/border_light" />
            </LinearLayout>

            <!-- Mode Selector: Products vs Artisans -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTabProducts"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Craft Products"
                    app:chipIcon="@drawable/ic_products"
                    app:chipIconTint="@color/selector_nav_item" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTabArtisans"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:checked="false"
                    android:text="Artisans &amp; SHGs"
                    app:chipIcon="@drawable/ic_artisans"
                    app:chipIconTint="@color/selector_nav_item" />
            </LinearLayout>

            <!-- Active Filters Scroll (Horizontal) -->
            <HorizontalScrollView
                android:id="@+id/scrollActiveFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupActiveFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Area with SwipeRefresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshExplore"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Products RecyclerView (Grid) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExploreProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="72dp"
                tools:listitem="@layout/item_product_card" />

            <!-- Artisans RecyclerView (List) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExploreArtisans"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp"
                android:visibility="gone"
                tools:listitem="@layout/item_artisan_card" />

            <!-- Initial Full-Screen Loading State -->
            <LinearLayout
                android:id="@+id/layoutExploreLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    style="@style/TextAppearance.KalaConnect.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Loading handcrafted traditions..." />
            </LinearLayout>

            <!-- Bottom Pagination Loading Indicator -->
            <ProgressBar
                android:id="@+id/pbExplorePagination"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutExploreEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Empty state"
                    android:src="@drawable/ic_empty_state"
                    app:tint="@color/text_tertiary" />

                <TextView
                    style="@style/TextAppearance.KalaConnect.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No Crafts Found"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextAppearance.KalaConnect.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Try adjusting your search keyword or clearing filters to discover more crafts." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreResetFilters"
                    style="@style/Widget.KalaConnect.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Reset Filters" />
            </LinearLayout>

            <!-- Error State -->
            <LinearLayout
                android:id="@+id/layoutExploreError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Error state"
                    android:src="@drawable/ic_error_state" />

                <TextView
                    android:id="@+id/tvExploreErrorMsg"
                    style="@style/TextAppearance.KalaConnect.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Failed to load crafts. Please check connection." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreRetry"
                    style="@style/Widget.KalaConnect.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Retry" />
            </LinearLayout>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
