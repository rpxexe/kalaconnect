<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Fragment Container for Active Customer Navigation Screen -->
    <FrameLayout
        android:id="@+id/customer_nav_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/customer_bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Customer Bottom Navigation Bar: Home, Explore, Enquiries, Notifications, Profile -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/customer_bottom_navigation"
        style="@style/Widget.KalaConnect.BottomNavigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        app:itemIconTint="@color/selector_nav_item"
        app:itemTextColor="@color/selector_nav_item"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_customer_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
