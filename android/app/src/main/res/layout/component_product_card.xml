    <?xml version="1.0" encoding="utf-8"?>
    <com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/cardProduct"
        style="@style/Widget.KalaConnect.Card"
        android:layout_width="@dimen/product_card_width"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image-First Visual Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/product_card_image_height"
                android:background="@drawable/bg_card_image_placeholder">

                <ImageView
                    android:id="@+id/ivProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Handcrafted Product Image"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_kala_logo" />

                <!-- Minimal Wishlist Button -->
                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:contentDescription="Save product to wishlist"
                    android:src="@drawable/ic_heart_outline" />
            </FrameLayout>

            <!-- Product Information Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Product Name -->
                <TextView
                    android:id="@+id/tvProductName"
                    style="@style/TextAppearance.KalaConnect.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="bold"
                    tools:text="Terracotta Chai Vessel" />

                <!-- Artisan / SHG Name -->
                <TextView
                    android:id="@+id/tvProductArtisan"
                    style="@style/TextAppearance.KalaConnect.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    tools:text="By Meera Devi • SHG" />

                <!-- Price & Location Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Price in Warm Primary Terracotta -->
                    <TextView
                        android:id="@+id/tvProductPrice"
                        style="@style/TextAppearance.KalaConnect.Price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="₹1,250" />

                    <!-- Location with Pin -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="Location icon"
                            android:src="@drawable/ic_location_pin" />

                        <TextView
                            android:id="@+id/tvProductLocation"
                            style="@style/TextAppearance.KalaConnect.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            tools:text="Gorakhpur" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
