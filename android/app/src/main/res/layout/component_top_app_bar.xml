<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutTopAppBarContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_app_bar_height"
    android:background="@color/background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Brand Mini Pottery Icon -->
    <ImageView
        android:id="@+id/ivAppBarLogo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="KalaConnect Brand Icon"
        android:src="@drawable/ic_kala_logo" />

    <!-- Title and Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAppBarTitle"
            style="@style/TextAppearance.KalaConnect.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            tools:text="Namaste, Visitor" />

        <TextView
            android:id="@+id/tvAppBarSubtitle"
            style="@style/TextAppearance.KalaConnect.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            tools:text="Explore Indian Artisan Crafts" />
    </LinearLayout>

    <!-- Optional Notification/Action Icon -->
    <ImageButton
        android:id="@+id/btnAppBarAction"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Notifications and Alerts"
        android:src="@drawable/ic_search" />

</LinearLayout>
