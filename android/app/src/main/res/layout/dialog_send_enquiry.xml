<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_role_card_unselected"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.KalaConnect.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/send_enquiry_title"
            android:textColor="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnEnquiryClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close enquiry"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Product Summary Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.KalaConnect.Card.Subtle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivEnquiryProductThumb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Product thumbnail"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_craft" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEnquiryProductName"
                    style="@style/TextAppearance.KalaConnect.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Handcrafted Terracotta Vase"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEnquiryProductArtisan"
                    style="@style/TextAppearance.KalaConnect.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="By Gorakhpur Clay Masters"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvEnquiryProductPrice"
                    style="@style/TextAppearance.KalaConnect.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="₹1,450"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Message Field -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.KalaConnect.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/your_message">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEnquiryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:lines="4" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Customer Contact Info (Optional for Guest / Confirmation) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.KalaConnect.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/your_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEnquiryCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.KalaConnect.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/your_contact">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEnquiryCustomerContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Progress indicator for submitting enquiry -->
    <ProgressBar
        android:id="@+id/pbEnquiryLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnquiryCancel"
            style="@style/Widget.KalaConnect.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnquirySubmit"
            style="@style/Widget.KalaConnect.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="8dp"
            android:layout_weight="1.4"
            android:text="@string/send_enquiry_btn" />
    </LinearLayout>

</LinearLayout>
