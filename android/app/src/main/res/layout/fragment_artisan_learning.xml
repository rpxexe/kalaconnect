<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.KalaConnect.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kala Vidya Hub"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/TextAppearance.KalaConnect.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Study craft modules &amp; test your knowledge"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_badge_gold"
                    android:contentDescription="Certificate badge"
                    android:padding="6dp"
                    android:src="@drawable/ic_certificate" />
            </LinearLayout>

            <!-- Navigation Tabs (Study Modules vs Knowledge Quiz vs Certificate) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupLearning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:checkedButton="@+id/btnTabModules"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabModules"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Study (6)"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabQuiz"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Knowledge Quiz"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabCertificate"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Certificate"
                    android:textSize="13sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="90dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================================================= -->
            <!-- SECTION 1: STUDY MODULES CONTAINER                        -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/containerStudyModules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Daily Pro-Tip Highlight Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/gold_light"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/gold_accent"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Tip bulb"
                                android:src="@drawable/ic_lightbulb"
                                app:tint="@color/gold_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Daily Master Artisan Tip"
                                android:textColor="@color/gold_dark"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDailyTipText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Always photograph your craft from 3 angles: The Hero Full View, The Macro Texture, and In-Hand for Scale. Soft morning sunlight near a window produces true colors without glare!"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section Heading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.KalaConnect.SectionHeading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Curated Study Guides"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 Available"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- RecyclerView for Modules -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLearningModules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_learning_module" />
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- SECTION 2: INTERACTIVE KNOWLEDGE QUIZ CONTAINER           -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/containerKnowledgeQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Quiz Progress Bar & Tracker -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvQuizProgressCounter"
                        style="@style/TextAppearance.KalaConnect.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        tools:text="Question 1 of 5" />

                    <TextView
                        android:id="@+id/tvQuizDomainBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_primary_light"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Fair Pricing &amp; Wages" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressQuizIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:indicatorColor="@color/primary"
                    app:trackColor="@color/border"
                    app:trackCornerRadius="4dp" />

                <!-- Active Question Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuizQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvQuizQuestionText"
                            style="@style/TextAppearance.KalaConnect.SectionHeading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            tools:text="When calculating the selling price of a handcrafted item, which essential cost is most often forgotten by rural artisans?" />

                        <!-- Radio Group for 4 Options -->
                        <RadioGroup
                            android:id="@+id/rgQuizOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp">

                            <RadioButton
                                android:id="@+id/rbOption0"
                                style="@style/TextAppearance.KalaConnect.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:padding="8dp"
                                android:textSize="14sp"
                                tools:text="Cost of courier tape and wrapping string" />

                            <RadioButton
                                android:id="@+id/rbOption1"
                                style="@style/TextAppearance.KalaConnect.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:padding="8dp"
                                android:textSize="14sp"
                                tools:text="The artisan's skilled labour hours at a fair living wage" />

                            <RadioButton
                                android:id="@+id/rbOption2"
                                style="@style/TextAppearance.KalaConnect.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:padding="8dp"
                                android:textSize="14sp"
                                tools:text="The electric recharge of their smartphone" />

                            <RadioButton
                                android:id="@+id/rbOption3"
                                style="@style/TextAppearance.KalaConnect.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:padding="8dp"
                                android:textSize="14sp"
                                tools:text="The color of the delivery receipt" />
                        </RadioGroup>

                        <!-- Answer Feedback & Explanation Card (Visible after answering) -->
                        <LinearLayout
                            android:id="@+id/layoutQuizExplanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_status_badge_success"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvQuizResultHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Correct Answer!"
                                android:textColor="@color/status_success"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvQuizExplanationText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                tools:text="Rural artisans frequently omit skilled labour hours. Skilled time must always be compensated!" />
                        </LinearLayout>

                        <!-- Quiz Action Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuizAction"
                            style="@style/Widget.KalaConnect.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginTop="16dp"
                            android:text="Verify Answer" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Completion / Results Card (Visible when quiz is completed) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuizCompletion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/gold_accent"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="Certificate badge"
                            android:src="@drawable/ic_certificate" />

                        <TextView
                            style="@style/TextAppearance.KalaConnect.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Knowledge Assessment Complete!"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tvQuizFinalScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="Score: 5 / 5 (100%)" />

                        <TextView
                            android:id="@+id/tvQuizCertificateTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_badge_gold"
                            android:text="★ Kala Certified Master Artisan ★"
                            android:textColor="@color/gold_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="2dp"
                            android:text="You have proven mastery in Fair Costing, GI Tag Preservation, Safe Packaging, and Smartphone Photography. Your verified badge is now unlocked!"
                            android:textAlignment="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewCertificate"
                            style="@style/Widget.KalaConnect.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginTop="20dp"
                            android:text="View Digital Certificate"
                            app:icon="@drawable/ic_certificate"
                            app:iconTint="@color/on_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRetakeQuiz"
                            style="@style/Widget.KalaConnect.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginTop="10dp"
                            android:text="Retake Assessment" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- SECTION 3: DIGITAL CERTIFICATE CONTAINER                  -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/containerCertificate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Certificate Status Banner (Approved, Pending, or Rejected) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCertificateStatusNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCertificateStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_badge_pending"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/status_pending"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="⏳ PENDING ADMIN APPROVAL" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvCertificateScoreBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Score: 5/5 (100%)" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCertificateStatusDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            tools:text="Your quiz results are being reviewed by the NGO Administrator. Once verified, your certificate of artisan excellence will be unlocked." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Printable/Displayable Certificate Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCertificateDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/gold_accent"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Kala logo"
                            android:src="@drawable/ic_kala_logo" />

                        <TextView
                            style="@style/TextAppearance.KalaConnect.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="KALACONNECT VIDYA"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="CERTIFICATE OF ARTISAN EXCELLENCE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/gold_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This is proudly conferred upon"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCertificateArtisanName"
                            style="@style/TextAppearance.KalaConnect.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            tools:text="Meera Bai" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Recognized Master Artisan • SHG Craft Collective"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingExtra="3dp"
                            android:text="For demonstrated mastery in Fair Living Wages, Indigenous GI Tag Preservation, Safe Packaging, and Direct-to-Buyer Digital Storytelling."
                            android:textAlignment="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="KalaConnect"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Heritage Council"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Gold seal"
                                android:src="@drawable/ic_certificate" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Status: Active"
                                    android:textColor="@color/status_success"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Verified Digital ID"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
