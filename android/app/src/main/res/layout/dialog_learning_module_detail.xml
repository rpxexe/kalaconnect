<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header: Close Button & Category Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_primary_light"
                android:letterSpacing="0.04"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="FINANCE" />

            <TextView
                android:id="@+id/tvDetailDuration"
                style="@style/TextAppearance.KalaConnect.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                tools:text="8 min study" />

            <ImageButton
                android:id="@+id/btnDetailClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close guide"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Module Title -->
        <TextView
            android:id="@+id/tvDetailTitle"
            style="@style/TextAppearance.KalaConnect.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Craft Costing: Never Underprice Your Heritage" />

        <!-- Subtitle Summary -->
        <TextView
            android:id="@+id/tvDetailSummary"
            style="@style/TextAppearance.KalaConnect.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Learn the standard KalaConnect formula to value every hour of master craftsmanship." />

        <!-- Practical Tip Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/gold_light"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/gold_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Tip Bulb"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="@color/gold_dark" />

                <TextView
                    android:id="@+id/tvDetailTip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/gold_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Tip: When buyers negotiate aggressively, explain the number of human hours dedicated to handcrafting the single piece." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key Takeaways Section -->
        <TextView
            style="@style/TextAppearance.KalaConnect.SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Key Rules &amp; Checklist"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvDetailKeyPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="• Rule 1: Always factor in living wages.\n• Rule 2: Add buffer for firing." />

        <!-- Detailed Study Content -->
        <TextView
            style="@style/TextAppearance.KalaConnect.SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="In-Depth Study Guide"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Detailed explanation of the costing formula..." />

        <!-- Bottom Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailDone"
            style="@style/Widget.KalaConnect.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:text="Complete Module &amp; Return"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="@color/on_primary" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
