<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/TextAppearance.KalaConnect.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Enquiries"
            android:textColor="@color/text_primary" />

        <TextView
            style="@style/TextAppearance.KalaConnect.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Track your conversations and custom requests with artisan collectives"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCustomerEnquiries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_enquiry_card" />

        <ProgressBar
            android:id="@+id/pbCustomerEnquiries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutCustomerEnquiriesEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="No enquiries"
                android:src="@drawable/ic_enquiries"
                tools:tint="@color/secondary" />

            <TextView
                style="@style/TextAppearance.KalaConnect.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No Enquiries Sent Yet"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/TextAppearance.KalaConnect.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Explore handmade crafts and send enquiries directly to master artisans for pricing, custom orders, or shipping." />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
