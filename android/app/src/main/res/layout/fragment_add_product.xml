<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarAddProduct"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@color/text_primary"
            app:title="Add Handcrafted Product"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvAddProductError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_status_badge_error"
                android:padding="12dp"
                android:textColor="@color/status_error"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Please provide all required product details." />

            <!-- Photo Upload Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Photography"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Upload clear photos capturing artisan craft details and texture"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Reusable Multi-Photo Picker Container -->
            <LinearLayout
                android:id="@+id/layoutPhotoPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Add Photo Trigger Button / Tile -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnAddPhotoCard"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Add Photo"
                            android:src="@drawable/ic_add"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="+ Add"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Picked Photos Horizontal RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPickedPhotos"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- Form Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider" />

            <!-- Product Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProductName"
                style="@style/Widget.KalaConnect.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Product Name *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Category & Craft Type Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Category -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProductCategory"
                    style="@style/Widget.KalaConnect.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="Category *">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProductCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Craft Type -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProductCraftType"
                    style="@style/Widget.KalaConnect.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="Craft Type">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProductCraftType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Material & Quantity Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Material -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProductMaterial"
                    style="@style/Widget.KalaConnect.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.3"
                    android:hint="Material">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProductMaterial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Quantity -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProductQuantity"
                    style="@style/Widget.KalaConnect.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.9"
                    android:hint="Quantity">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProductQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="1"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Price & Location Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Price -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProductPrice"
                    style="@style/Widget.KalaConnect.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="Price (₹) *"
                    app:prefixText="₹ ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProductPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Location -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProductLocation"
                    style="@style/Widget.KalaConnect.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.2"
                    android:hint="Craft Location">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProductLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ============================================================== -->
            <!-- Gemini AI Story & Promotion Assistant Card -->
            <!-- ============================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiAssistant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/secondary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Gemini AI"
                            android:src="@drawable/ic_auto_awesome"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="AI Story &amp; Promotion Assistant"
                            android:textColor="@color/primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Generate rich artisan storytelling, social media promotional captions, and hashtags powered by Gemini AI."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Optional Features / Specific Motifs Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAiFeatures"
                        style="@style/Widget.KalaConnect.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Special Features / Motifs (Optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAiFeatures"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Trigger Button: [Generate with AI] -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateAi"
                        style="@style/Widget.KalaConnect.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="✨ Generate with AI"
                        app:icon="@drawable/ic_auto_awesome"
                        app:iconGravity="textStart"
                        app:iconTint="@color/primary" />

                    <!-- AI Loading State -->
                    <LinearLayout
                        android:id="@+id/layoutAiLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            app:indicatorColor="@color/primary"
                            app:trackColor="@color/border_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Crafting story with Gemini AI..."
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Weaving cultural heritage into descriptions"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- AI Error & Retry State -->
                    <LinearLayout
                        android:id="@+id/layoutAiError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_status_badge_error"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvAiErrorMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/status_error"
                            android:textSize="13sp"
                            tools:text="AI generation timed out. Please check your connection and retry." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRetryAi"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:text="Retry"
                            android:textColor="@color/status_error"
                            app:icon="@drawable/ic_refresh"
                            app:iconTint="@color/status_error" />
                    </LinearLayout>

                    <!-- AI Generated Content Container (Result) -->
                    <LinearLayout
                        android:id="@+id/layoutAiResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Review Label Banner -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_ai_notice"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="AI-generated content — review before publishing."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="italic" />
                        </LinearLayout>

                        <!-- Editable Section 1: Product Description -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Product Description"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilAiDescription"
                            style="@style/Widget.KalaConnect.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAiDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:inputType="textMultiLine|textCapSentences"
                                android:lines="4"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Editable Section 2: Promotion Caption -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Promotion Caption"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilAiCaption"
                            style="@style/Widget.KalaConnect.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAiCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:inputType="textMultiLine|textCapSentences"
                                android:lines="2"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Editable Section 3: Hashtags -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hashtags"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilAiHashtags"
                            style="@style/Widget.KalaConnect.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAiHashtags"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="@color/primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Action Buttons Row: Regenerate, Edit, Use Content -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Regenerate -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiRegenerate"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_height"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1.1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Regenerate"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_refresh"
                                app:iconSize="16dp"
                                app:iconTint="@color/text_primary"
                                app:strokeColor="@color/border_light" />

                            <!-- Edit -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiEdit"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_height"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="0.8"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Edit"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_edit"
                                app:iconSize="16dp"
                                app:iconTint="@color/text_primary"
                                app:strokeColor="@color/border_light" />

                            <!-- Use Content (Artisan Explicit Confirmation) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiUseContent"
                                style="@style/Widget.KalaConnect.Button.Primary"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_height"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1.2"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Use Content"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_check"
                                app:iconSize="16dp" />
                        </LinearLayout>

                        <!-- Content Confirmed Banner (Shows when artisan explicitly accepts) -->
                        <LinearLayout
                            android:id="@+id/layoutAiConfirmedBanner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_status_badge_success"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Confirmed"
                                android:src="@drawable/ic_check"
                                app:tint="@color/status_success" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Content confirmed &amp; applied to product form."
                                android:textColor="@color/status_success"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Description -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProductDescription"
                style="@style/Widget.KalaConnect.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Product Story &amp; Description *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lines="4"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save / Publish Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitProduct"
                style="@style/Widget.KalaConnect.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginBottom="32dp"
                android:text="Publish Product" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading State Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlayAddProduct"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FAF8F5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/primary" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
