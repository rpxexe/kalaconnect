<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutEmptyStateContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivEmptyIllustration"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="Empty state pottery illustration"
        android:src="@drawable/ic_empty_state" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        style="@style/TextAppearance.KalaConnect.SectionHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        tools:text="No Handcrafted Items Found" />

    <TextView
        android:id="@+id/tvEmptyDescription"
        style="@style/TextAppearance.KalaConnect.BodySecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        tools:text="Our craftspeople are preparing new authentic pieces. Explore other categories or check back soon." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyAction"
        style="@style/Widget.KalaConnect.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="Explore All Crafts" />

</LinearLayout>
