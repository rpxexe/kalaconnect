<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutChipContainer"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/chip_height"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_chip_unselected"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/tvChipLabel"
        style="@style/TextAppearance.KalaConnect.BodySecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="Terracotta Pottery" />

</LinearLayout>
