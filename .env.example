# =============================================================================
# KalaConnect Backend Environment Variables Template
# Copy this file to .env or export these variables in your deployment environment.
# DO NOT COMMIT ACTUAL PASSWORDS OR SECRETS TO VERSION CONTROL.
# =============================================================================

# Aiven PostgreSQL JDBC Connection URL
# Note: For Aiven PostgreSQL, ensure 'sslmode=require' is configured in the URL.
DB_URL=jdbc:postgresql://HOST:PORT/DATABASE?sslmode=require

# Aiven PostgreSQL Database Username
DB_USERNAME=avnadmin

# Aiven PostgreSQL Database Password
DB_PASSWORD=your_aiven_database_password_here

# JWT Signing Secret (256-bit / 32+ characters secret key for HMAC-SHA256)
JWT_SECRET=your_secure_256_bit_secret_key_for_jwt_token_signing_here

# Server Port (optional, defaults to 8080)
PORT=8080

# Google Gemini API Key (Required for AI Product Content Generation)
# The Gemini API key must exist ONLY on the backend service. Never in mobile code.
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

